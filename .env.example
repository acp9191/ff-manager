# Yahoo Fantasy API credentials (https://developer.yahoo.com/apps/)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Where to send alerts. Run `ffm telegram-setup` to get these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alternatives, if you would rather not create a bot. The first one
# configured wins; set FFM_NOTIFY to pick explicitly.
# NTFY_TOPIC=
# DISCORD_WEBHOOK_URL=
# FFM_NOTIFY=telegram

# Optional: a written summary on `ffm week --brief`. Everything still works
# without it — the computed reasons are always printed.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-5   # see `ffm models`

# Used by docker-compose.yml.
FFM_LEAGUE_ID=
FFM_SLEEPER_USER=
TZ=America/New_York
